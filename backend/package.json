{
  "name": "money-support-backend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
